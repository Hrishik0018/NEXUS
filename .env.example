# Copy to .env, edit, then:  set -a; source .env; set +a
# (.env is git-ignored - never commit real passwords)

# PostgreSQL (used by the Master only)
NEXUS_DB_HOST=localhost
NEXUS_DB_PORT=5432
NEXUS_DB_NAME=nexus
NEXUS_DB_USER=nexus
NEXUS_DB_PASSWORD=change_me

# Master location (used by Workers) and listening port (used by the Master)
NEXUS_MASTER_HOST=127.0.0.1
NEXUS_MASTER_PORT=5050

# Optional
NEXUS_HEARTBEAT_SEC=3          # Worker heartbeat interval (Workers AND Master must agree)
NEXUS_QUIET_HEARTBEAT=0        # 1 = Master hides per-heartbeat log lines
